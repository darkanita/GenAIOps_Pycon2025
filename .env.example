# ===== Proveedor del LLM =====
# openai | groq
LLM_PROVIDER=openai
# Opcional: modelo de chat (default: gpt-4o para openai, openai/gpt-oss-120b para groq)
# LLM_MODEL=
# Opcional: modelo usado como juez en run_eval.py (default: el mismo LLM_MODEL)
# EVAL_MODEL=

# ===== Proveedor de embeddings =====
# openai | fastembed  (default: openai si LLM_PROVIDER=openai, fastembed si LLM_PROVIDER=groq)
# Groq no ofrece embeddings: fastembed los calcula localmente, sin API key.
# EMBEDDINGS_PROVIDER=
# EMBEDDINGS_MODEL=

# ===== API Keys (solo la del proveedor que uses) =====
OPENAI_API_KEY=sk-xxxxx
GROQ_API_KEY=gsk_xxxxx

# ===== Configuración RAG =====
PROMPT_VERSION=v1_asistente_rrhh
CHUNK_SIZE=512
CHUNK_OVERLAP=50
