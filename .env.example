# ===== Proveedor del LLM =====
# openai | groq
LLM_PROVIDER=openai
# Opcional: modelo de chat (default: gpt-4o para openai, openai/gpt-oss-120b para groq)
# LLM_MODEL=
# Opcional: juez de run_eval.py en formato proveedor:/modelo
# (default: openai:/gpt-4o-mini con OpenAI, groq:/openai/gpt-oss-20b con Groq)
# EVAL_MODEL=
# Opcional: ejecutar solo algunos jueces (ahorra cuota mientras iteras)
# EVAL_SCORERS=correctness,retrieval_groundedness

# Opcional: ritmo de la evaluación. Con LLM_PROVIDER=groq se usa un modo pausado
# automáticamente (1 pregunta y 2 jueces a la vez, ~12 llamadas/min, 8 reintentos).
# MLFLOW_GENAI_EVAL_MAX_WORKERS=1
# MLFLOW_GENAI_EVAL_MAX_SCORER_WORKERS=2
# MLFLOW_GENAI_EVAL_SCORER_RATE_LIMIT=0.2
# MLFLOW_GENAI_EVAL_MAX_RETRIES=8

# ===== Proveedor de embeddings =====
# openai | fastembed  (default: openai si LLM_PROVIDER=openai, fastembed si LLM_PROVIDER=groq)
# Groq no ofrece embeddings: fastembed los calcula localmente, sin API key.
# EMBEDDINGS_PROVIDER=
# EMBEDDINGS_MODEL=

# ===== API Keys (solo la del proveedor que uses) =====
OPENAI_API_KEY=sk-xxxxx
GROQ_API_KEY=gsk_xxxxx

# ===== Configuración RAG =====
# Prompt desde el MLflow Prompt Registry: @alias, /versión o @latest.
# También acepta el nombre de un archivo local de app/prompts/ (p. ej. v1_asistente_rrhh).
PROMPT_VERSION=prompts:/asistente_rrhh@production
RETRIEVER_K=4
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ===== MLflow =====
# Por defecto se usa ./mlflow.db (SQLite). Para un servidor remoto:
# MLFLOW_TRACKING_URI=http://localhost:5000
